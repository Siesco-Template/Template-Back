<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

	<AssemblyName>FilterComponent</AssemblyName>
	
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	
	<PackageId>Siesco-Template.Filter</PackageId>
	<Version>1.0.5</Version>
	<Authors>Siesco</Authors>
	<Company>Siesco</Company>
	<Description>.NET library that provides a robust and flexible solution for managing and applying user-defined filters within your applications, specifically designed for MongoDB integration.</Description>
	<PackageTags>filter;mongodb;template</PackageTags>
	<RepositoryUrl>https://github.com/Siesco-Template/Template-Back.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
		<PackageReference Include="MongoDB.Driver" Version="3.4.0" />
		<PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.2" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Siesco-QueryGenerator" Version="1.0.2" />
	  <PackageReference Include="Siesco-Template.SharedLibrary" Version="1.0.0" />
	</ItemGroup>
	
</Project>