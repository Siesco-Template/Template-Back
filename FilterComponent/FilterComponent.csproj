<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

	<AssemblyName>FilterComponent</AssemblyName>
	
	<!-- NuGet Package Properties -->
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	
	<PackageId>Template-Back.Filter</PackageId>
	
	<Title>Template-Back.Filter</Title>
	
	<Authors>Siesco Studio</Authors>
	
	<Company>Siesco</Company>
	
	<Version>1.0.0</Version>
	
	<Description></Description>
	
	<RepositoryUrl>https://github.com/Siesco-Template/Template-Back.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	
	<AssemblyVersion>1.0.0</AssemblyVersion>
	
	<FileVersion>1.0.0</FileVersion>
	
	<PackAsTool>False</PackAsTool>
	
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
		<PackageReference Include="MongoDB.Driver" Version="3.4.0" />
		<PackageReference Include="System.Linq.Dynamic.Core" Version="1.6.2" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Template-Back.QueryGenerator" Version="1.0.0" />
	  <ProjectReference Include="..\SharedLibrary\SharedLibrary.csproj" />
	</ItemGroup>
	
</Project>