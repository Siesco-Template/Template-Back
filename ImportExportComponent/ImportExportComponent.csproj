<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

	<AssemblyName>ImportExportComponent</AssemblyName>
	
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	
	<PackageId>Siesco-Template.ImportExport</PackageId>
	<Version>1.0.3</Version>
	<Authors>Siesco</Authors>
	<Company>Siesco</Company>
	<Description>Import and export functionality for Template architecture.</Description>
	<PackageTags>import;export;template</PackageTags>
	<RepositoryUrl>https://github.com/Siesco-Template/Template-Back.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.0" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
		<PackageReference Include="MassTransit" Version="8.4.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.16" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.16" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Siesco-Template.Table" Version="1.0.5" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\SharedLibrary\SharedLibrary.csproj" />
	</ItemGroup>
</Project>