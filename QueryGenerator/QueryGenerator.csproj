<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  
	<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
	<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

	<AssemblyName>QueryGenerator</AssemblyName>
	
	<!-- NuGet Package Properties -->
	<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	
	<PackageId>Template-Back.QueryGenerator</PackageId>
	
	<Title>Template-Back.QueryGenerator</Title>
	
	<Authors>Siesco Studio</Authors>
	
	<Company>Siesco</Company>
	
	<Version>1.0.0</Version>
	
	<Description></Description>
	
	<RepositoryUrl>https://github.com/Siesco-Template/Template-Back.git</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	
	<AssemblyVersion>1.0.0</AssemblyVersion>
	
	<FileVersion>1.0.0</FileVersion>
	
	<PackAsTool>False</PackAsTool>
	
	<IncludeSymbols>true</IncludeSymbols>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
		<PackageReference Include="System.Collections" Version="4.3.0" />
	</ItemGroup>

</Project>