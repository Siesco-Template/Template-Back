<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

	<PackageId>Siesco-QueryGenerator</PackageId>
	<Version>1.0.2</Version>
		<Authors>Siesco</Authors>
		<Company>Siesco</Company>
		<Description>Query generator helpers for Template architecture.</Description>
		<PackageTags>query;generator;template</PackageTags>
		<RepositoryUrl>https://github.com/Siesco-Template/Template-Back.git</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="JetBrains.Annotations" Version="2024.3.0" />
		<PackageReference Include="System.Collections" Version="4.3.0" />
	</ItemGroup>

</Project>